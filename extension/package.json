{
  "name": "recordmeeting-extension",
  "version": "1.0.0",
  "description": "Chrome extension for recording and transcribing Google Meet meetings",
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r public dist/public && cp manifest.json dist/",
    "watch": "tsc --watch",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0",
    "dexie": "^3.2.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
